{
  "name": "omnivoice-studio-monorepo",
  "version": "0.5.8",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "clean": "node scripts/clean-all.mjs",
    "clean:all": "node scripts/clean-all.mjs",
    "setup:api": "node scripts/setup-api.mjs",
    "dev:api": "bun scripts/dev-backend.mjs",
    "dev:frontend": "bun run --cwd electron dev:web",
    "dev:desktop": "bun run --cwd electron dev",
    "wait:api": "node scripts/wait-app-port.mjs api",
    "wait:frontend": "node scripts/wait-app-port.mjs web",
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "bun run --cwd electron dev",
    "predesktop": "node electron/scripts/node-version.mjs && bun install",
    "desktop": "bun run --cwd electron dev",
    "build": "bun run --cwd electron build",
    "check:electron": "node scripts/validate_store_foundation.mjs && bun run --cwd electron typecheck && bun run --cwd electron test && bun run --cwd electron build && bun run --cwd electron build:web && node electron/tests/packaging-contract.mjs",
    "start": "bun run --cwd electron start",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "smoke-test": "node scripts/electron-smoke-test.mjs",
    "deps:check": "taze -r --maturity-period 7",
    "dev:web": "bun run setup:api && concurrently -n api,fe -c green,cyan --kill-others-on-fail \"bun run dev:api\" \"bun run dev:frontend\"",
    "predev:web": "node electron/scripts/node-version.mjs && bun install && bun scripts/clear-dev-ports.mjs",
    "build:web": "bun run --cwd electron build:web",
    "dist": "bun run --cwd electron dist --publish never",
    "desktop-prod": "bun run build && bun run start",
    "desktop-prod:run": "bun run start",
    "desktop-prod:upgrade": "bun run desktop-prod",
    "test": "bun run --cwd electron test",
    "typecheck": "bun run --cwd electron typecheck",
    "lint": "bun run --cwd electron lint",
    "format": "bun run --cwd electron format",
    "dist:dir": "bun run --cwd electron dist:dir --publish never"
  },
  "workspaces": ["electron"],
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "taze": "^21.3.0",
    "wait-on": "^9.5.1"
  },
  "patchedDependencies": {
    "app-builder-lib@26.15.3": "patches/app-builder-lib-26.15.3.patch"
  }
}
