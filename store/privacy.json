{
  "schemaVersion": 1,
  "policyUrl": "https://voicestudio.sh/privacy",
  "defaultBehavior": {
    "accountRequired": false,
    "analyticsEnabled": false,
    "audioUploaded": false,
    "projectsUploaded": false
  },
  "localData": [
    "recorded and imported audio",
    "generated audio and video",
    "voice profiles and consent recordings",
    "project history and settings",
    "model weights and managed runtime files",
    "optional Hugging Face credential"
  ],
  "transmittedData": [
    {
      "destination": "Supermetry",
      "condition": "explicit analytics opt-in",
      "purpose": "product analytics and sanitized error diagnostics",
      "data": [
        "random per-installation identifier",
        "application version and platform",
        "closed-set workflow and engine labels",
        "counts, durations and text length without text",
        "coarse error class and stage without messages, stack frames or local paths"
      ],
      "excluded": [
        "audio",
        "transcripts and prompts",
        "voice and project names",
        "filenames and local paths",
        "credentials",
        "DOM capture and session recordings"
      ]
    },
    {
      "destination": "GitHub API",
      "condition": "public star badge is visible",
      "purpose": "display the public repository star count",
      "data": ["ordinary network request metadata"],
      "excluded": ["credentials", "user content", "project data"]
    },
    {
      "destination": "User-selected download providers",
      "condition": "explicit setup, model, gallery, update or media-tool action",
      "purpose": "download the requested runtime, model, gallery asset, update or media tool",
      "data": ["ordinary request metadata", "provider credential only when required"],
      "excluded": ["audio", "transcripts", "project content"]
    }
  ]
}
