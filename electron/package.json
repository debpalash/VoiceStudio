{
  "name": "voicestudio-electron",
  "version": "0.0.0-electron",
  "private": true,
  "description": "VoiceStudio desktop shell (Electron) - local voice cloning, no cloud.",
  "homepage": "https://github.com/debpalash/VoiceStudio",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "VoiceStudio contributors",
    "email": "VoiceStudio@palash.dev"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:software-compositing": "electron-vite dev -- --disable-gpu-compositing",
    "locale:check": "node tests/locale-encoding.mjs && node tests/locale-source-keys.mjs && node tests/locale-coverage.mjs",
    "build": "bun run locale:check && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "bun run locale:check && vp test --run",
    "test:watch": "vp test",
    "smoke:server": "vite --config tests/renderer-smoke.vite.config.mjs",
    "smoke:live-routes": "node tests/live-route-health.mjs",
    "check": "vp check",
    "dist": "bun run locale:check && electron-vite build && node tests/packaging-contract.mjs && electron-builder --config electron-builder.config.mjs && node --input-type=module -e \"if (process.platform === 'linux') await import('./scripts/embed-appimage-update.mjs')\" && node tests/update-package-contract.mjs",
    "dist:dir": "bun run locale:check && electron-vite build && node tests/packaging-contract.mjs && electron-builder --config electron-builder.config.mjs --dir",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@scalar/api-reference-react": "^0.9.67",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/store": "^0.11.1",
    "@vidstack/react": "1.15.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dashjs": "^5.2.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "posthog-js": "^1.431.2",
    "proxy-agent": "6.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "remotion": "4.0.524",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^7.12.12",
    "word-extractor": "1.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "builder-util": "26.15.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plus": "^0.3.1",
    "vitest": "4.1.11"
  },
  "desktopName": "VoiceStudio",
  "productName": "VoiceStudio",
  "trustedDependencies": [
    "electron",
    "esbuild",
    "electron-builder",
    "app-builder-bin"
  ]
}
